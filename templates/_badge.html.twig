{% set tones = {
    ok: 'border-emerald-400/40 bg-emerald-400/10 text-emerald-300',
    fault: 'border-rose-400/40 bg-rose-400/10 text-rose-300',
    info: 'border-sky-400/40 bg-sky-400/10 text-sky-300',
    warning: 'border-amber-400/40 bg-amber-400/10 text-amber-300',
    muted: 'border-slate-600 bg-slate-800/50 text-slate-400',
} %}
<span class="inline-block rounded border px-2 py-0.5 text-xs font-bold uppercase tracking-wider {{ tones[tone] }}">{{ label }}</span>
