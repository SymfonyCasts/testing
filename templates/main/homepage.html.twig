{% extends 'base.html.twig' %}

{% block title %}Starship repair &amp; diagnostics{% endblock %}

{% block body %}
    <section class="rounded-lg border border-sky-400/30 bg-slate-900/70 p-8 shadow-[0_0_40px_-15px] shadow-sky-400/40 sm:p-12">
        <p class="text-xs uppercase tracking-[0.3em] text-sky-400">// Diagnostic bay online</p>
        <h1 class="mt-4 text-3xl font-bold leading-tight text-white sm:text-5xl">
            Your ship.<br>
            <span class="text-sky-300">Every system.</span><br>
            <span class="text-emerald-400">OK.</span>
        </h1>
        <p class="mt-6 max-w-2xl text-slate-400">
            Warp core making that noise again? Shields flickering whenever you water the ferns?
            Dock at Shipshape and our engineers will test the whole system until every light reads OK.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
            <a href="{{ path('app_book_repair') }}" class="rounded bg-sky-400 px-5 py-2.5 font-bold text-slate-950 hover:bg-sky-300">Book a repair</a>
            <a href="{{ path('app_ships') }}" class="rounded border border-slate-600 px-5 py-2.5 hover:border-sky-400 hover:text-sky-300">See who's in dock</a>
        </div>
    </section>

    <section class="mt-10 grid gap-6 sm:grid-cols-3">
        {% for feature in [
            {title: 'Full diagnostics', text: 'Warp core to comms: we scan every system, every time.'},
            {title: 'Certified engineers', text: 'Our crew can fix anything with a hyperspanner and a strong cup of tea.'},
            {title: 'Back in orbit fast', text: 'Most ships leave the dock shipshape within a day.'},
        ] %}
            <div class="rounded-lg border border-slate-800 bg-slate-900/50 p-6">
                <h2 class="font-bold text-sky-300">{{ feature.title }}</h2>
                <p class="mt-2 text-sm text-slate-400">{{ feature.text }}</p>
            </div>
        {% endfor %}
    </section>
{% endblock %}
