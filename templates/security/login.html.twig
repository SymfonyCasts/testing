{% extends 'base.html.twig' %}

{% set input_class = 'mt-2 block w-full rounded border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100 focus:border-sky-400 focus:outline-none' %}
{% set label_class = 'block text-sm font-bold uppercase tracking-wider text-slate-300' %}

{% block title %}Engineer login{% endblock %}

{% block body %}
    <div class="mx-auto max-w-md">
        <h1 class="text-3xl font-bold text-white">Engineer login</h1>
        <p class="mt-2 text-slate-400">Crew only. Captains, you can <a href="{{ path('app_book_repair') }}" class="text-sky-300 underline">book a repair</a> without an account.</p>

        <form method="post" action="{{ path('app_login') }}" class="mt-8 space-y-6 rounded-lg border border-slate-800 bg-slate-900/60 p-6">
            {% if error %}
                <p class="rounded border border-rose-400/40 bg-rose-400/10 px-4 py-3 text-sm text-rose-300">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </p>
            {% endif %}

            <div>
                <label for="username" class="{{ label_class }}">Email</label>
                <input type="email" value="{{ last_username }}" name="_username" id="username" class="{{ input_class }}" autocomplete="email" required autofocus>
            </div>

            <div>
                <label for="password" class="{{ label_class }}">Password</label>
                <input type="password" name="_password" id="password" class="{{ input_class }}" autocomplete="current-password" required>
            </div>

            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="rounded bg-sky-400 px-5 py-2.5 font-bold text-slate-950 hover:bg-sky-300">Log in</button>
        </form>
    </div>
{% endblock %}
