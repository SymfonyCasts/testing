{% extends 'base.html.twig' %}

{% set input_class = 'mt-2 block w-full rounded border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100 focus:border-sky-400 focus:outline-none' %}
{% set label_class = 'block text-sm font-bold uppercase tracking-wider text-slate-300' %}

{% block title %}Book a repair{% endblock %}

{% block body %}
    <div class="mx-auto max-w-2xl">
        <h1 class="text-3xl font-bold text-white">Book a repair</h1>
        <p class="mt-2 text-slate-400">Tell us what's wrong and our engineers will add your ship to the repair queue.</p>

        {{ form_start(form, {attr: {class: 'mt-8 space-y-6 rounded-lg border border-slate-800 bg-slate-900/60 p-6', novalidate: 'novalidate'}}) }}
            <div class="[&_li]:mt-2 [&_li]:text-sm [&_li]:text-rose-400">
                {{ form_label(form.ship, null, {label_attr: {class: label_class}}) }}
                {{ form_widget(form.ship, {attr: {class: input_class}}) }}
                {{ form_errors(form.ship) }}
            </div>

            <div class="[&_li]:mt-2 [&_li]:text-sm [&_li]:text-rose-400">
                {{ form_label(form.reporterEmail, null, {label_attr: {class: label_class}}) }}
                {{ form_widget(form.reporterEmail, {attr: {class: input_class, placeholder: 'captain@example.space'}}) }}
                {{ form_errors(form.reporterEmail) }}
            </div>

            <fieldset class="[&_li]:mt-2 [&_li]:text-sm [&_li]:text-rose-400">
                <legend class="{{ label_class }}">Priority</legend>
                <div class="mt-3 flex flex-wrap gap-6">
                    {% for choice in form.priority %}
                        <div class="flex items-center gap-2">
                            {{ form_widget(choice, {attr: {class: 'accent-sky-400'}}) }}
                            {{ form_label(choice) }}
                        </div>
                    {% endfor %}
                </div>
                {{ form_errors(form.priority) }}
            </fieldset>

            <div class="[&_li]:mt-2 [&_li]:text-sm [&_li]:text-rose-400">
                {{ form_label(form.description, null, {label_attr: {class: label_class}}) }}
                {{ form_widget(form.description, {attr: {class: input_class, placeholder: 'The warp core hums in B-flat...'}}) }}
                {{ form_errors(form.description) }}
            </div>

            <button type="submit" class="rounded bg-sky-400 px-5 py-2.5 font-bold text-slate-950 hover:bg-sky-300">Book repair</button>
        {{ form_end(form) }}
    </div>
{% endblock %}
