+<?php
+
+namespace App\Tests\Feature;
+
+use Symfony\Bundle\FrameworkBundle\Test\WebTestCase;
+
+class ShipTest extends WebTestCase
+{
+    public function testShipShow(): void
+    {
+        $client = static::createClient();
+        $crawler = $client->request('GET', '/ships/uss-espresso');
+
+        $this->assertResponseIsSuccessful();
+        $this->assertSelectorTextContains('h1', 'USS Espresso');
+        $this->assertAnySelectorTextContains('p', 'Latte-class');
+    }
+}
